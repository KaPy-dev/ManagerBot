# Dev-профиль: ТЕСТОВЫЙ бот для отладки локального стека. Скопируйте в conf.dev.env и заполните.
# Прод-бот живёт в conf.env и на этот файл не смотрит.

# Токен тестового бота от @BotFather (пока заглушка — run-dev.sh не даст запуститься, пока не заменить)
TOKEN=PASTE_DEV_BOT_TOKEN_HERE
# Ваш Telegram ID (как в conf.env) — чтобы /admin работал и в тестовом боте
OWNER_ID=8040789094
# Тестовую группу выбирать в самом боте: /admin → «📌 Чат для заявок». Хранится в storage-dev/settings.json
MANAGER_CHAT_ID=0

# Внешний HTTP API для локального сайта. Порт 8091, чтобы не пересекаться с продовым 8090.
# Локальный сайт (DIPLED_ENV=dev) читает секрет и порт отсюда сам — в админке ничего вводить не нужно.
API_SECRET=dev-local-secret-change-me
API_HOST=127.0.0.1
API_PORT=8091
